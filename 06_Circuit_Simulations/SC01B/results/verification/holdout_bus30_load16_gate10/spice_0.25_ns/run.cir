SC01B independent engine control
.control
set ngbehavior=ps
set numdgt=17
set wr_singlescale
set wr_vecnames
source halfbridge.cir
tran 2.5000000000000002e-10 5.0000000000000004e-06 0 2.5000000000000002e-10
wrdata waveform.dat v(sw) v(bus) v(hg,sw) v(lg) v(hd,sw) v(ld) i(Vh) i(Vl) i(Vhg) i(Vlg) i(Lload) i(Lfeed)
quit
.endc
.end
